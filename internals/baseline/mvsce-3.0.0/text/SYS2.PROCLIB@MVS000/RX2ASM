//RX2ASM   PROC SLIB=,           //* SOURCE LIBRARY OF RX MEMBER
//         REXX=,                //* REXX TO COMPILE
//         LIB='BREXX.RXLIB',    //* RXLIB
//         MODE=1,               //* COMPILE MODE
//         LLIB=                 //* LINK INTO LIBRARY
//* --------------------------------------------------------
//* GENERATE ASSEMBLER PROGRAM
//* --------------------------------------------------------
//EXEC   EXEC PGM=BREXX,PARM='RXRUN &SLIB(&REXX),MODE=&MODE',
//         REGION=8192K
//RXRUN    DD DSN=&LIB(RX2ASM),DISP=SHR
//RXLIB    DD DSN=&LIB,DISP=SHR
//STDIN    DD DUMMY
//STDOUT   DD SYSOUT=*,DCB=(RECFM=FB,LRECL=140,BLKSIZE=5600)
//STDERR   DD SYSOUT=*,DCB=(RECFM=FB,LRECL=140,BLKSIZE=5600)
//RXOUT    DD DSN=&&RXASM,DISP=(NEW,PASS),UNIT=SYSDA,
//            SPACE=(TRK,(10,19)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=6400)
//RXLNK    DD DSN=&&RXLNK,DISP=(NEW,PASS),UNIT=SYSDA,
//            SPACE=(TRK,(1,1)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=6400)
//* --------------------------------------------------------
//* ASSEMBLY OF GENERATED PROGRAM
//* --------------------------------------------------------
//ASM    EXEC PGM=IFOX00,PARM=(OBJ,NORENT),REGION=128K
//SYSIN    DD DISP=SHR,DSN=&&RXASM
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//         DD DSN=SYS2.MACLIB,DISP=SHR
//         DD DSN=BREXX.RUNTIME.MACLIB,DISP=SHR
//SYSUT1   DD DSN=&&SYSUT1,UNIT=SYSSQ,SPACE=(1700,(600,100)),
//            SEP=(SYSLIB)
//SYSUT2   DD DSN=&&SYSUT2,UNIT=SYSSQ,SPACE=(1700,(300,50)),
//            SEP=(SYSLIB,SYSUT1)
//SYSUT3   DD DSN=&&SYSUT3,UNIT=SYSSQ,SPACE=(1700,(300,50))
//SYSPRINT DD SYSOUT=H,DCB=BLKSIZE=1089
//SYSPUNCH DD SYSOUT=B
//SYSGO    DD DSN=&&OBJSET,UNIT=SYSSQ,SPACE=(80,(200,50)),
//            DISP=(MOD,PASS)
//* --------------------------------------------------------
//* LINKAGE OF GENERATED PROGRAM
//* --------------------------------------------------------
//LKED   EXEC PGM=IEWL,REGION=128K,COND=(8,LT,ASM),
//            PARM='AC=0,XREF,LIST,CALL,NORENT,SIZE=(999424,65536)'
//SYSLIB   DD DISP=SHR,DSN=SYS2.LINKLIB
//SYSLIN   DD DSN=&&OBJSET,DISP=(OLD,DELETE)
//         DD DDNAME=SYSIN
//SYSIN    DD DSN=&&RXLNK,DISP=(OLD,DELETE)
//SYSPRINT DD SYSOUT=H,DCB=BLKSIZE=1089
//SYSUT1   DD DSN=&&SYSUT1,UNIT=(SYSDA,SEP=(SYSLIN,SYSLMOD)),
//            SPACE=(1024,(50,20))
//SYSLMOD  DD DSN=&LLIB(&REXX),DISP=SHR
//* PEND
